{
  "name": "job-photo-organizer",
  "version": "0.1.0",
  "description": "Categorize, date-check, rename and file job-site photos for the customer record.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder",
    "build:mobile": "node scripts/build-mobile.js",
    "serve:mobile": "node scripts/build-mobile.js && npx --yes http-server dist-mobile -p 8080"
  },
  "build": {
    "appId": "com.eccsolar.jobphotoorganizer",
    "productName": "Job Photo Organizer",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "build/icon.png",
      "config.default.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "icon": "build/icon.png"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "heic-convert": "^2.1.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "license": "UNLICENSED"
}
